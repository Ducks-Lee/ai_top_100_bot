# 복사해서 .env로 저장한 뒤 값을 채운다. .env는 git에 올리지 않는다.
# 프로그램이 시작할 때 프로젝트 폴더의 .env를 읽는다(config.py). 같은 이름의 환경변수가 이미 있으면 그 값이 우선한다.

# 카카오 디벨로퍼스 > 앱 > [제품 설정] > [카카오톡 봇] > [봇]의 봇 인증 토큰
BOT_TOKEN=

# 에이전트 처리 시간 상한(초). 콜백 토큰 만료(5분) 기준으로 더 짧게 자동 조정된다.
AGENT_TIMEOUT_SEC=240

# 1로 두면 받은 이벤트 원본을 로그에 남긴다 (콜백 토큰은 가림, 개인정보 포함이므로 형식 확인할 때만)
LOG_PAYLOAD=0

# 로그 파일 폴더(기본 logs, 프로젝트 폴더 기준). 파일로 남기지 않으려면 주석을 풀고 값을 비운다.
# LOG_DIR=

# 서비스가 실패하면 알림을 보낼 디스코드 웹훅 URL (채널 설정 > 연동 > 웹후크). 비우면 알림을 보내지 않는다.
DISCORD_WEBHOOK_URL=

# 봇이 쓰는 Anthropic API 키 (console.anthropic.com > API Keys). agent.py가 읽는다.
ANTHROPIC_API_KEY=

# 운영진 액션 서버(API). 주소와 키는 대회 당일 문제 페이지에서 확인한다. action_api.py가 읽는다.
ACTION_API_BASE_URL=
ACTION_API_KEY=
# 상담(TC) ID를 보내는 헤더 이름(기본 X-Test-Case-Id). 종단 시험(test_cs_live.py) 시작 때 초기화할 경로(선택).
# ACTION_TC_HEADER=
# ACTION_RESET_PATH=

# CS 에이전트 설정·규칙 파일(기본: data/cs_config.json·data/rules.md가 있으면 그것, 없으면 공개 예시 cs_config.example.json·rules.example.md)
# CS_CONFIG_FILE=
# CS_RULES_FILE=

# --- 웹훅 방식(main.py)을 쓸 때만 ---
# 웹훅 설정에 등록한 커스텀 헤더 (요청이 카카오에서 왔는지 검증)
WEBHOOK_HEADER_NAME=
WEBHOOK_HEADER_VALUE=

# Anthropic 사용액 집계(spend.py, 추정치). 충전액(달러)이 바뀌면 누적을 0부터 다시 센다. 충전 시각은 기록용.
CREDIT_TOPUP_USD=20
CREDIT_TOPUP_AT=
# 사용액 디스코드 보고 간격(초). 프롬프트 캐시 예열 간격(초).
# SPEND_REPORT_SEC=3600
# WARM_INTERVAL_SEC=3000
# 예산 가드(cs_agent.budget_stage). 남은 추정액(달러)이 이하이면 절약 모드(Haiku, 도구 3회), 멈춤(LLM 없이 고정 문구).
ECONOMY_BELOW_USD=6
STOP_BELOW_USD=1.5
